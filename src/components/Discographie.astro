---
import { Image } from 'astro:assets';
import Ph from './Ph.astro';
import { discographie, discographieResume } from '@/data/artiste';
import { ui, type Lang } from '@/i18n';
import { fmt } from '@/lib/text';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const avec = { fr: 'avec Kunta Kinté', en: 'with Kunta Kinté' };
---

<div>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <h2 class="text-4xl sm:text-5xl">{lang === 'fr' ? 'Discographie' : 'Discography'}</h2>
    <p class="text-sm text-texte-2" set:html={fmt(discographieResume[lang])} />
  </div>
  <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-3 lg:grid-cols-6" role="list">
    {
      discographie.map((a) => (
        <li>
          {a.pochette ? (
            <Image
              src={a.pochette}
              alt={`${lang === 'fr' ? 'Pochette de l’album' : 'Album cover:'} ${a.titre}`}
              widths={[200, 400]}
              sizes="(min-width: 1024px) 180px, (min-width: 768px) 30vw, 45vw"
              format="webp"
              loading="lazy"
              class="aspect-square w-full rounded-lg object-cover shadow-sm"
            />
          ) : (
            <Ph label="[Pochette]" class="aspect-square" />
          )}
          <p class="mt-3 text-xs text-texte-2">
            <span set:html={fmt(a.annee)} />
            {a.distinction && ` · ${a.distinction[lang]}`}
            {a.avecKuntaKinte && ` · ${avec[lang]}`}
          </p>
          <h3 class="mt-1 text-xl leading-tight">{a.titre}</h3>
          <p class="mt-1 text-sm text-texte-2">{a.texte[lang]}</p>
          {a.ecouter && (
            <a href={a.ecouter} target="_blank" rel="noopener" class="lien mt-2 inline-block py-1 text-sm text-terracotta">
              {ui.commun.ecouter[lang]} →
            </a>
          )}
        </li>
      ))
    }
  </ul>
</div>
