---
import Social from './Social.astro';
import { site, mailtoUrl, whatsappUrl } from '@/data/site';
import { href, slugOf, ui, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const slug = slugOf(Astro.url.pathname);
const f = ui.footer;
---

<footer class="bg-noir pb-24 text-creme sm:pb-0">
  <div class="container-site grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-serif text-2xl">Meïssa Mbaye</p>
      <p class="mt-3 max-w-60 text-sm text-creme/80">{f.accroche[lang]}</p>
      <Social lang={lang} class="mt-5" />
    </div>

    <nav aria-labelledby="pied-spectacles">
      <h2 id="pied-spectacles" class="font-sans text-sm font-semibold">{f.spectacles[lang]}</h2>
      <ul class="mt-3 space-y-1 text-sm text-creme/80" role="list">
        <li><a class="inline-block py-1 hover:text-creme" href={href(lang, 'borom-ndeer')}>{f.boromLong[lang]}</a></li>
        <li><a class="inline-block py-1 hover:text-creme" href={href(lang, 'conteur')}>{f.conteurLong[lang]}</a></li>
        <li><a class="inline-block py-1 hover:text-creme" href={href(lang, 'pedagogue')}>{f.ateliers[lang]}</a></li>
      </ul>
    </nav>

    <nav aria-labelledby="pied-decouvrir">
      <h2 id="pied-decouvrir" class="font-sans text-sm font-semibold">{f.decouvrir[lang]}</h2>
      <ul class="mt-3 space-y-1 text-sm text-creme/80" role="list">
        <li><a class="inline-block py-1 hover:text-creme" href={href(lang, 'borom-ndeer') + '#parcours'}>{f.parcours[lang]}</a></li>
        <li><a class="inline-block py-1 hover:text-creme" href={href(lang, 'tournee')}>{ui.nav.tournee[lang]}</a></li>
        <li><a class="inline-block py-1 hover:text-creme" href={href(lang, 'conteur') + '#livre'}>{f.livre[lang]}</a></li>
        <li><a class="inline-block py-1 hover:text-creme" href={href(lang, 'galerie')}>{f.galerie[lang]}</a></li>
        <li><a class="inline-block py-1 hover:text-creme" href={href(lang, 'pro')}>{ui.nav.pro[lang]}</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="font-sans text-sm font-semibold">{f.contact[lang]}</h2>
      <ul class="mt-3 space-y-1 text-sm" role="list">
        <li><a class="inline-block break-all py-1 text-creme/80 hover:text-creme" href={mailtoUrl}>{site.bookingEmail}</a></li>
        <li><a class="lien inline-block py-1 text-or" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp {site.whatsapp.affichage}</a></li>
      </ul>
      <p class="mt-4 text-sm font-semibold">{f.france[lang]}</p>
      <address class="mt-1 text-sm not-italic leading-relaxed text-creme/80">
        {site.france.adresse.slice(0, 2).join(', ')}<br />
        {site.france.adresse.slice(2).join(', ')}<br />
        <a class="inline-block py-1 hover:text-creme" href={`tel:${site.france.telephone.numero}`}>{site.france.telephone.affichage}</a>
      </address>
      <a href={href(lang, 'contact')} class="btn btn-or mt-4">{f.reserverSpectacle[lang]}</a>
    </div>
  </div>

  <div class="border-t border-creme/10">
    <div class="container-site flex flex-col gap-3 py-5 text-xs text-creme/70 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {new Date().getFullYear()} Meïssa Mbaye · Werekaan Institute ·{' '}
        <a class="hover:text-creme" href={href(lang, 'mentions-legales')}>{f.realisation[lang]} {site.mentions.realisation.nom}</a>
      </p>
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1" role="list">
        <li><a class="inline-block py-2 underline underline-offset-4 hover:text-creme" href={href(lang, 'mentions-legales')}>{f.mentions[lang]}</a></li>
        <li><a class="inline-block py-2 underline underline-offset-4 hover:text-creme" href={href(lang, 'confidentialite')}>{f.confidentialite[lang]}</a></li>
        <li>
          <a href={href('fr', slug)} hreflang="fr" lang="fr" class:list={['p-1', lang === 'fr' && 'text-creme underline underline-offset-4']}>FR</a>
          <span aria-hidden="true">·</span>
          <a href={href('en', slug)} hreflang="en" lang="en" class:list={['p-1', lang === 'en' && 'text-creme underline underline-offset-4']}>EN</a>
        </li>
      </ul>
    </div>
  </div>
</footer>
