---
/** Emplacement réservé pour une image pas encore fournie (remplacé via la médiathèque Directus). */
interface Props {
  label: string;
  class?: string;
  tone?: 'sable' | 'indigo' | 'sombre';
}
const { label, class: className = '', tone = 'sable' } = Astro.props;
const tons = {
  sable: 'bg-sable-fonce/70 text-texte-2',
  indigo: 'bg-indigo-pale text-indigo',
  sombre: 'bg-scene text-creme/60',
};
---

<div role="img" aria-label={label} class:list={['flex items-center justify-center rounded-lg p-4 text-center text-xs', tons[tone], className]}>
  <span aria-hidden="true">{label}</span>
</div>
