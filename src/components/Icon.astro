---
import { siInstagram, siFacebook, siYoutube, siTiktok, siX, siSpotify, siWhatsapp } from 'simple-icons';

const marques = {
  instagram: siInstagram.path,
  facebook: siFacebook.path,
  youtube: siYoutube.path,
  tiktok: siTiktok.path,
  x: siX.path,
  // Absent de simple-icons : logo LinkedIn redessiné sur la même grille 24 px.
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  spotify: siSpotify.path,
  whatsapp: siWhatsapp.path,
};

// Icônes d'interface, trait 1.75 sur une grille 24 px.
const interface_ = {
  menu: 'M4 7h16M4 12h16M4 17h16',
  fermer: 'M6 6l12 12M18 6L6 18',
  pause: 'M9 5v14M15 5v14',
  telecharger: 'M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19h14',
};

export type IconName = keyof typeof marques | keyof typeof interface_ | 'lecture';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = 'size-5' } = Astro.props;
---

{
  name === 'lecture' ? (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M8 5.5v13l10.5-6.5z" />
    </svg>
  ) : name in marques ? (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={marques[name as keyof typeof marques]} />
    </svg>
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d={interface_[name as keyof typeof interface_]} />
    </svg>
  )
}
