---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { site, mailtoUrl, whatsappUrl } from '@/data/site';
import { href, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = {
  fr: {
    titre: 'Contact et réservation',
    description: 'Réservez Meïssa Mbaye Boroom Ndeer ou Meïssa conteur pour votre festival, médiathèque, école ou salle. Réponse sous 48 h.',
    kicker: 'Booking · France, Belgique, international',
    h1: 'Réserver un spectacle',
    intro: 'Décrivez votre projet : nous revenons vers vous sous 48 h avec les disponibilités et un devis.',
    offre: 'Spectacle souhaité',
    offres: [
      { v: 'borom-ndeer', l: 'Meïssa Mbaye Boroom Ndeer — concert de poésie chantée' },
      { v: 'conteur', l: 'Meïssa conteur — contes, dès 6 ans' },
      { v: 'atelier', l: "Atelier d'art oratoire" },
      { v: 'bokk-baat', l: 'Bokk Baat — atelier de chant, la voix partagée' },
      { v: 'kaay-wax', l: 'Kaay Wax — paroles partagées, école de la déclamation' },
      { v: 'formation', l: 'Formation, coaching ou cours de chant' },
      { v: 'indecis', l: 'Je ne sais pas encore' },
    ],
    structureLegende: 'Votre structure',
    structure: 'Nom de la structure',
    type: 'Type',
    types: [
      { v: 'festival', l: 'Festival' },
      { v: 'mediatheque', l: 'Médiathèque' },
      { v: 'ecole', l: 'École, collège, lycée' },
      { v: 'centre_culturel', l: 'Centre culturel, salle' },
      { v: 'institut', l: 'Institut, Alliance française' },
      { v: 'autre', l: 'Autre' },
    ],
    choisir: 'Choisir…',
    ville: 'Ville',
    pays: 'Pays',
    vousLegende: 'Vous',
    nom: 'Prénom et nom',
    fonction: 'Fonction',
    email: 'E-mail',
    telephone: 'Téléphone (avec indicatif)',
    projetLegende: 'Votre projet',
    date: 'Date ou période souhaitée',
    dateAide: 'Par exemple : mars 2027, ou « date flexible ».',
    public: 'Public attendu',
    publicAide: 'Par exemple : familles, 7–12 ans, 200 places.',
    message: 'Message',
    obligatoire: 'obligatoire',
    consentement:
      'J’accepte que ces informations soient utilisées pour répondre à ma demande. Elles ne sont ni revendues ni partagées.',
    confidentialite: 'Politique de confidentialité',
    envoyer: 'Envoyer la demande',
    envoi: 'Envoi en cours…',
    succes: 'Merci, votre demande est bien arrivée. Un accusé de réception vous est envoyé par e-mail ; nous vous répondons sous 48 h.',
    demo: 'Mode démonstration : le formulaire n’est pas encore relié à l’administration, la demande n’a pas été envoyée. Écrivez-nous directement par e-mail ou WhatsApp.',
    erreur: 'L’envoi n’a pas abouti. Réessayez dans un instant, ou écrivez-nous par e-mail ou WhatsApp.',
    autre: 'Vous préférez écrire directement ?',
  },
  en: {
    titre: 'Contact and booking',
    description: 'Book Meïssa Mbaye Boroom Ndeer or Meïssa the storyteller for your festival, library, school or venue. Reply within 48 hours.',
    kicker: 'Booking · France, Belgium, worldwide',
    h1: 'Book a show',
    intro: 'Tell us about your project: we will get back to you within 48 hours with availability and a quote.',
    offre: 'Show',
    offres: [
      { v: 'borom-ndeer', l: 'Meïssa Mbaye Boroom Ndeer — sung-poetry concert' },
      { v: 'conteur', l: 'Meïssa the storyteller — tales, ages 6 and up' },
      { v: 'atelier', l: 'Oratory workshop' },
      { v: 'bokk-baat', l: 'Bokk Baat — singing workshop, the shared voice' },
      { v: 'kaay-wax', l: 'Kaay Wax — shared words, school of declamation' },
      { v: 'formation', l: 'Training, coaching or singing lessons' },
      { v: 'indecis', l: 'Not sure yet' },
    ],
    structureLegende: 'Your organisation',
    structure: 'Organisation name',
    type: 'Type',
    types: [
      { v: 'festival', l: 'Festival' },
      { v: 'mediatheque', l: 'Library' },
      { v: 'ecole', l: 'School' },
      { v: 'centre_culturel', l: 'Arts centre, venue' },
      { v: 'institut', l: 'Cultural institute, Alliance française' },
      { v: 'autre', l: 'Other' },
    ],
    choisir: 'Choose…',
    ville: 'City',
    pays: 'Country',
    vousLegende: 'You',
    nom: 'Full name',
    fonction: 'Position',
    email: 'Email',
    telephone: 'Phone (with country code)',
    projetLegende: 'Your project',
    date: 'Preferred date or period',
    dateAide: 'For example: March 2027, or “flexible”.',
    public: 'Expected audience',
    publicAide: 'For example: families, ages 7–12, 200 seats.',
    message: 'Message',
    obligatoire: 'required',
    consentement: 'I agree that this information may be used to answer my request. It is never sold or shared.',
    confidentialite: 'Privacy policy',
    envoyer: 'Send request',
    envoi: 'Sending…',
    succes: 'Thank you, your request has arrived. You will receive an acknowledgement by email; we reply within 48 hours.',
    demo: 'Demo mode: the form is not yet connected to the admin, so your request was not sent. Please write to us directly by email or WhatsApp.',
    erreur: 'Sending failed. Please try again shortly, or write to us by email or WhatsApp.',
    autre: 'Prefer to write directly?',
  },
}[lang];

const champ = 'mt-1 block min-h-11 w-full rounded-lg border border-bordure bg-carte px-3 py-2 text-base text-noir placeholder:text-texte-2/60 focus:border-noir focus:outline-none focus-visible:outline-3 focus-visible:outline-or';
const etiquette = 'block text-sm font-medium';
const req = `<span class="text-terracotta" aria-hidden="true">*</span>`;
---

<Base lang={lang} title={t.titre} description={t.description}>
  <section class="bg-noir text-creme">
    <div class="container-site pb-14 pt-12 sm:pt-16">
      <p class="kicker text-or">{t.kicker}</p>
      <h1 class="mt-4 text-5xl sm:text-7xl">{t.h1}</h1>
      <p class="mt-5 max-w-xl text-creme/85">{t.intro}</p>
    </div>
  </section>

  <div class="container-site grid gap-12 py-16 sm:py-20 lg:grid-cols-[2fr_1fr]">
    <form
      class="grid gap-10"
      method="post"
      novalidate
      data-formulaire
      data-msg-envoi={t.envoi}
      data-msg-succes={t.succes}
      data-msg-demo={t.demo}
      data-msg-erreur={t.erreur}
    >
      <div>
        <label for="offre" class={etiquette}>{t.offre} <Fragment set:html={req} /></label>
        <select id="offre" name="offre" required class={champ}>
          {t.offres.map((o) => <option value={o.v}>{o.l}</option>)}
        </select>
      </div>

      <fieldset class="grid gap-5 sm:grid-cols-2">
        <legend class="mb-4 font-serif text-3xl">{t.structureLegende}</legend>
        <div class="sm:col-span-2">
          <label for="structure" class={etiquette}>{t.structure} <Fragment set:html={req} /></label>
          <input id="structure" name="structure" required autocomplete="organization" class={champ} />
        </div>
        <div>
          <label for="type" class={etiquette}>{t.type}</label>
          <select id="type" name="type_structure" class={champ}>
            <option value="">{t.choisir}</option>
            {t.types.map((o) => <option value={o.v}>{o.l}</option>)}
          </select>
        </div>
        <div>
          <label for="ville" class={etiquette}>{t.ville}</label>
          <input id="ville" name="ville" autocomplete="address-level2" class={champ} />
        </div>
        <div>
          <label for="pays" class={etiquette}>{t.pays} <Fragment set:html={req} /></label>
          <input id="pays" name="pays" required autocomplete="country-name" class={champ} />
        </div>
      </fieldset>

      <fieldset class="grid gap-5 sm:grid-cols-2">
        <legend class="mb-4 font-serif text-3xl">{t.vousLegende}</legend>
        <div>
          <label for="nom" class={etiquette}>{t.nom} <Fragment set:html={req} /></label>
          <input id="nom" name="nom" required autocomplete="name" class={champ} />
        </div>
        <div>
          <label for="fonction" class={etiquette}>{t.fonction}</label>
          <input id="fonction" name="fonction" autocomplete="organization-title" class={champ} />
        </div>
        <div>
          <label for="email" class={etiquette}>{t.email} <Fragment set:html={req} /></label>
          <input id="email" name="email" type="email" required autocomplete="email" class={champ} />
        </div>
        <div>
          <label for="telephone" class={etiquette}>{t.telephone}</label>
          <input id="telephone" name="telephone" type="tel" autocomplete="tel" class={champ} />
        </div>
      </fieldset>

      <fieldset class="grid gap-5 sm:grid-cols-2">
        <legend class="mb-4 font-serif text-3xl">{t.projetLegende}</legend>
        <div>
          <label for="date" class={etiquette}>{t.date}</label>
          <input id="date" name="date_souhaitee" aria-describedby="date-aide" class={champ} />
          <p id="date-aide" class="mt-1 text-xs text-texte-2">{t.dateAide}</p>
        </div>
        <div>
          <label for="public" class={etiquette}>{t.public}</label>
          <input id="public" name="public" aria-describedby="public-aide" class={champ} />
          <p id="public-aide" class="mt-1 text-xs text-texte-2">{t.publicAide}</p>
        </div>
        <div class="sm:col-span-2">
          <label for="message" class={etiquette}>{t.message}</label>
          <textarea id="message" name="message" rows="6" class={champ}></textarea>
        </div>
      </fieldset>

      <!-- Piège à robots : invisible pour les humains -->
      <div class="hidden" aria-hidden="true">
        <label for="site_web">Site web</label>
        <input id="site_web" name="site_web" tabindex="-1" autocomplete="off" />
      </div>

      <div>
        <div class="flex gap-3">
          <input id="consentement" name="consentement" type="checkbox" required class="mt-1 size-5 shrink-0 accent-noir" />
          <label for="consentement" class="text-sm">
            {t.consentement} <Fragment set:html={req} />
            <a href={href(lang, 'confidentialite')} class="lien ml-1">{t.confidentialite}</a>
          </label>
        </div>
        <p class="mt-4 text-xs text-texte-2"><span class="text-terracotta" aria-hidden="true">*</span> {t.obligatoire}</p>
      </div>

      <div>
        <button type="submit" class="btn btn-or px-8" data-envoyer>{t.envoyer}</button>
        <div class="mt-5 rounded-lg p-4 text-sm empty:hidden" role="status" aria-live="polite" data-statut></div>
      </div>
    </form>

    <aside class="lg:pt-2">
      <div class="carte p-6">
        <h2 class="text-3xl">{t.autre}</h2>
        <ul class="mt-5 grid gap-3 text-sm" role="list">
          <li>
            <a href={mailtoUrl} class="btn btn-contour-sombre w-full break-all">{site.bookingEmail}</a>
          </li>
          <li>
            <a href={whatsappUrl} target="_blank" rel="noopener" class="btn btn-noir w-full">
              <Icon name="whatsapp" class="size-4" />
              WhatsApp {site.whatsapp.affichage}
            </a>
          </li>
        </ul>
      </div>
    </aside>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-formulaire]');
  if (form) {
    // Offre pré-remplie depuis les boutons « Réserver ce concert / ce spectacle » (?offre=…).
    const offre = new URLSearchParams(location.search).get('offre');
    const select = form.querySelector<HTMLSelectElement>('#offre')!;
    if (offre && [...select.options].some((o) => o.value === offre)) select.value = offre;

    const statut = form.querySelector<HTMLElement>('[data-statut]')!;
    const bouton = form.querySelector<HTMLButtonElement>('[data-envoyer]')!;
    const libelleBouton = bouton.textContent;
    const afficher = (texte: string, ton: 'info' | 'ok' | 'erreur') => {
      statut.textContent = texte;
      statut.className = `mt-5 rounded-lg p-4 text-sm ${ton === 'ok' ? 'bg-[#D5E5D3] text-[#24502A]' : ton === 'erreur' ? 'bg-[#EBD5C8] text-[#7A3215]' : 'bg-[#F6E3C0] text-[#6B4A0E]'}`;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }
      const donnees = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (donnees.site_web) return; // robot
      delete donnees.site_web;

      // En ligne : script PHP de l'hébergement IONOS (public/api/demande.php). En local, pas de PHP : mode démo.
      const endpoint = (import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined) || (import.meta.env.PROD ? '/api/demande.php' : '');
      if (!endpoint) {
        afficher(form.dataset.msgDemo!, 'info');
        return;
      }

      bouton.disabled = true;
      bouton.textContent = form.dataset.msgEnvoi!;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...donnees, langue: document.documentElement.lang, source: 'site', page: document.referrer }),
        });
        if (!res.ok || !(await res.json().catch(() => null))?.ok) throw new Error(String(res.status));
        form.reset();
        afficher(form.dataset.msgSucces!, 'ok');
      } catch {
        afficher(form.dataset.msgErreur!, 'erreur');
      } finally {
        bouton.disabled = false;
        bouton.textContent = libelleBouton;
      }
    });
  }
</script>
