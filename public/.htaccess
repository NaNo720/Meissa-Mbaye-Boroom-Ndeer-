# Réglages Apache pour l'hébergement IONOS (équivalent de public/_redirects pour Netlify).
RewriteEngine On

# Redirections 301 (déplacement définitif, conservé par Google). NE garde le « # » de l'ancre.
# Page « L'artiste » fusionnée dans Borom Ndeer.
RewriteRule ^artiste/?$ /borom-ndeer#parcours [R=301,L,NE]
RewriteRule ^en/artiste/?$ /en/borom-ndeer#parcours [R=301,L,NE]
# Kaay Wox renommé Kaay Wax.
RewriteRule ^pedagogue/kaay-wox/?$ /pedagogue/kaay-wax [R=301,L]
RewriteRule ^en/pedagogue/kaay-wox/?$ /en/pedagogue/kaay-wax [R=301,L]

# Page d'erreur du site.
ErrorDocument 404 /404.html

# Fichiers versionnés par Astro (nom unique à chaque build) : cache d'un an.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|avif|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
