# URL publique du site (hreflang, sitemap).
SITE_URL=https://meissambaye.com

# Point d'envoi du formulaire de réservation. Vide = /api/demande.php en ligne (PHP IONOS), mode démo en local.
PUBLIC_FORM_ENDPOINT=

# Mise en ligne (npm run deploy) : accès SFTP de l'hébergement IONOS. Copier ce fichier en .env et compléter.
# Ne jamais versionner ni partager le fichier .env.
SFTP_HOST=
SFTP_USER=
SFTP_PASSWORD=
SFTP_PORT=22
SFTP_DIR=/public
